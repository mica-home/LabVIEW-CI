# ci/vm.env.example - template for the local-only VM credential file.
# Copy to ci/vm.env and fill in real values. Never commit it: the repo's
# .gitignore ignores *.env. Used by the ZCode session to drive the VMware
# build VM (vmrun / WinRM) without prompting.
#
# Security boundary: plaintext on disk is readable by same-user processes
# and local administrators (same accepted risk as ci/release.env). The
# session reads these variables and never echoes them; vmrun process
# arguments contain the password transiently (visible locally only).

# --- VMware ---
# Full path to vmrun.exe from your VMware Workstation installation
VMRUN_PATH=<path-to-vmrun.exe>
# Path to the encrypted VM's vmx file
VMX_PATH=<path-to-your-encrypted-vmx>
# The VM's encryption password (vmrun requires it for any guest operation
# on an encrypted VM)
VMX_ENCRYPTION_PASSWORD=<your-vm-encryption-password>

# --- Guest OS local administrator account (used by vmrun -gu/-gp and WinRM) ---
# "guest" is VMware terminology for the VM's operating system - not the
# disabled Windows "Guest" account. Any local administrator works. If the VM
# logs in with a Microsoft account, use a dedicated local admin instead
# (MSA credentials are unreliable for vmrun/WinRM).
VM_GUEST_USER=<guest-local-admin-username>
VM_GUEST_PASSWORD=<guest-local-admin-password>

# --- Target guest IP (VMware NAT subnet; find it via the VM's MAC and ARP) ---
VM_GUEST_IP=<guest-ip>

# --- Optional: Gitea PAT (scope write:repository) ---
# Unlocks git push, CI run inspection and runner status queries from the session.
GITEA_PUSH_TOKEN=

# --- Gitea runner registration token (needed once by the runner bootstrap) ---
# Get it from the Gitea web UI: repo Settings -> Actions -> Runners.
# Short-lived; registration-only; safe to reset after the runner is registered.
GITEA_RUNNER_REGISTRATION_TOKEN=
